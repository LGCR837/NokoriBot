<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NokoriBot WebUI</title>
<style>
  :root {
    --bg: #0f1117;
    --panel: #171a23;
    --panel-2: #1e2230;
    --border: #2a2f3e;
    --text: #e6e9f0;
    --muted: #8b93a7;
    --accent: #4f7cff;
    --accent-2: #7a90ff;
    --green: #34d399;
    --red: #f87171;
    --radius: 10px;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, "Segoe UI", "Microsoft YaHei", sans-serif;
    min-height: 100vh;
  }
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 24px;
    background: var(--panel);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .topbar .brand { font-size: 18px; font-weight: 700; }
  .brand span { color: var(--accent-2); }
  .status-area { display: flex; align-items: center; gap: 14px; font-size: 13px; color: var(--muted); }
  .status-dot {
    width: 10px; height: 10px; border-radius: 50%;
    background: var(--red); display: inline-block; margin-right: 6px;
  }
  .status-dot.online { background: var(--green); box-shadow: 0 0 8px var(--green); }
  .tabs {
    display: flex;
    gap: 4px;
    padding: 10px 24px 0;
    background: var(--panel);
    border-bottom: 1px solid var(--border);
  }
  .tab-btn {
    padding: 10px 22px;
    background: transparent;
    border: none;
    color: var(--muted);
    font-size: 14px;
    cursor: pointer;
    border-radius: 8px 8px 0 0;
    border-bottom: 2px solid transparent;
    transition: all .15s;
  }
  .tab-btn:hover { color: var(--text); }
  .tab-btn.active {
    color: var(--text);
    border-bottom-color: var(--accent);
    background: var(--panel-2);
  }
  .container { max-width: 960px; margin: 0 auto; padding: 24px; }
  .panel { display: none; }
  .panel.active { display: block; }
  /* 日志面板：去掉卡片框，log-box 撑满剩余高度 + 大致全宽（保留少量边距，不溢出） */
  #panel-logs.active {
    display: flex;
    flex-direction: column;
    min-height: 70vh;
    margin-left: calc(-50vw + 50% + 12px);
    margin-right: calc(-50vw + 50% + 12px);
  }
  #panel-logs .log-box { flex: 1; min-height: 0; max-height: none; }
  .card {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
    margin-bottom: 16px;
  }
  .card h3 { font-size: 15px; margin-bottom: 14px; color: var(--accent-2); }
  .plugin-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 16px;
    background: var(--panel-2);
    border-radius: 8px;
    margin-bottom: 10px;
  }
  .plugin-info { flex: 1; min-width: 0; }
  .plugin-name { font-weight: 600; font-size: 14px; }
  .plugin-meta { font-size: 12px; color: var(--muted); margin-top: 4px; }
  .plugin-desc { font-size: 12.5px; color: var(--text); margin-top: 6px; opacity: .85; }
  .plugin-actions { display: flex; align-items: center; gap: 12px; }
  .badge {
    font-size: 11px; padding: 3px 10px; border-radius: 20px;
    background: var(--green); color: #06281c; font-weight: 600;
  }
  .badge.off { background: #3a3f4d; color: var(--muted); }
  .switch { position: relative; width: 44px; height: 24px; cursor: pointer; }
  .switch input { opacity: 0; width: 0; height: 0; }
  .slider {
    position: absolute; inset: 0;
    background: #3a3f4d;
    border-radius: 24px;
    transition: .2s;
  }
  .slider::before {
    content: ''; position: absolute; width: 18px; height: 18px;
    left: 3px; top: 3px; border-radius: 50%;
    background: #fff; transition: .2s;
  }
  .switch input:checked + .slider { background: var(--green); }
  .switch input:checked + .slider::before { transform: translateX(20px); }
  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .form-group { display: flex; flex-direction: column; gap: 6px; }
  .form-group label { font-size: 12.5px; color: var(--muted); }
  .form-group input, .form-group select {
    background: var(--panel-2);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 10px 12px;
    color: var(--text);
    font-size: 13.5px;
    outline: none;
  }
  .form-group input:focus, .form-group select:focus { border-color: var(--accent); }
  .btn {
    background: var(--accent);
    border: none;
    color: #fff;
    padding: 10px 24px;
    border-radius: 8px;
    font-size: 13.5px;
    cursor: pointer;
    transition: filter .15s;
  }
  .btn:hover { filter: brightness(1.15); }
  .btn:disabled { opacity: .5; cursor: not-allowed; }
  .btn.secondary {
    background: var(--panel-2);
    border: 1px solid var(--border);
    color: var(--text);
  }
  .btn.danger { background: var(--red); }
  .btn.small { padding: 6px 12px; font-size: 12px; border-radius: 6px; }
  .modal-mask {
    position: fixed; inset: 0; background: rgba(0,0,0,.55);
    display: none; align-items: center; justify-content: center; z-index: 50;
  }
  .modal-mask.show { display: flex; }
  .modal {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 12px;
    width: min(680px, 92vw);
    max-height: 84vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .modal-head {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 18px; border-bottom: 1px solid var(--border);
  }
  .modal-head h3 { font-size: 15px; color: var(--accent-2); }
  .modal-close { background: none; border: none; color: var(--muted); font-size: 20px; cursor: pointer; }
  .modal-body { padding: 16px 18px; overflow-y: auto; flex: 1; }
  .modal-foot { display: flex; justify-content: flex-end; gap: 10px; padding: 12px 18px; border-top: 1px solid var(--border); }
  .config-editor {
    width: 100%; min-height: 320px; resize: vertical;
    background: #0b0d12; border: 1px solid var(--border); border-radius: 8px;
    color: var(--text); font-family: "Cascadia Code", Consolas, monospace;
    font-size: 12.5px; line-height: 1.6; padding: 12px; outline: none;
    white-space: pre; tab-size: 2;
  }
  .config-editor:focus { border-color: var(--accent); }
  .config-error { color: var(--red); font-size: 12.5px; margin-top: 8px; }
  .log-box {
    /* 去掉框：无边框/背景/圆角/内边距，日志全宽紧凑显示 */
    font-family: "Cascadia Code", Consolas, monospace;
    font-size: 12px;
    line-height: 1.75;
    max-height: 560px;
    overflow-y: auto;
    word-break: break-all;
  }
  /* 每行日志一个轻量卡片，紧凑纵向排列，整体仍像大段文本 */
  .log-entry {
    display: flex;
    align-items: baseline;
    gap: 6px;
    padding: 1px 8px;
    border-radius: 4px;
    border-left: 2px solid transparent;
  }
  .log-entry:hover { background: rgba(255,255,255,0.045); }
  .log-entry .log-time {
    color: #e5e7eb;           /* 时间白色 */
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
  }
  .log-entry .log-level { flex-shrink: 0; font-weight: 600; }
  .log-entry .log-msg { color: #d1d5db; flex: 1; white-space: pre-wrap; }
  .log-entry.debug { border-left-color: #6b7280; } .log-entry.debug .log-level { color: #9ca3af; }
  .log-entry.info  { border-left-color: #22c55e; } .log-entry.info  .log-level { color: #4ade80; }
  .log-entry.warn  { border-left-color: #fbbf24; } .log-entry.warn  .log-level { color: #fcd34d; }
  .log-entry.error { border-left-color: #f87171; } .log-entry.error .log-level { color: #f87171; }
  .log-entry.debug .log-msg { color: #8b949e; }
  .log-entry.info  .log-msg { color: #86efac; }
  .log-entry.warn  .log-msg { color: #fde68a; }
  .log-entry.error .log-msg { color: #fecaca; }
  .toast {
    position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%);
    background: var(--panel-2);
    border: 1px solid var(--accent);
    color: var(--text);
    padding: 12px 22px;
    border-radius: 8px;
    font-size: 13px;
    opacity: 0;
    transition: opacity .25s;
    pointer-events: none;
    z-index: 99;
  }
  .toast.show { opacity: 1; }
  .empty { color: var(--muted); font-size: 13px; padding: 20px 0; text-align: center; }
  @media (max-width: 640px) {
    .form-grid { grid-template-columns: 1fr; }
    .topbar { padding: 12px 16px; }
  }
</style>
</head>
<body>

<div class="topbar">
  <div class="brand">Nokori<span>Bot</span> WebUI</div>
  <div class="status-area">
    <span><span class="status-dot" id="statusDot"></span><span id="statusText">离线</span></span>
    <span id="statusUser">未登录</span>
    <span id="statusUptime"></span>
  </div>
</div>

<div class="tabs">
  <button class="tab-btn active" data-tab="plugins">插件管理</button>
  <button class="tab-btn" data-tab="config">Bot 配置</button>
  <button class="tab-btn" data-tab="contacts">联系人</button>
  <button class="tab-btn" data-tab="logs">日志查看</button>
</div>

<div class="container">
  <!-- 插件管理 -->
  <div class="panel active" id="panel-plugins">
    <div class="card">
      <h3>已安装插件</h3>
      <div id="pluginList"><div class="empty">加载中...</div></div>
    </div>
  </div>

  <!-- Bot 配置 -->
  <div class="panel" id="panel-config">
    <div class="card">
      <h3>连接配置</h3>
      <form id="configForm" class="form-grid">
        <div class="form-group">
          <label>后端地址（backendOrigin）</label>
          <input name="backendOrigin" placeholder="https://api.example.com">
        </div>
        <div class="form-group">
          <label>媒体地址（mediaOrigin）</label>
          <input name="mediaOrigin" placeholder="https://media.example.com">
        </div>
        <div class="form-group">
          <label>用户名</label>
          <input name="username" placeholder="登录用户名">
        </div>
        <div class="form-group">
          <label>密码</label>
          <input name="password" type="password" placeholder="登录密码">
        </div>
        <div class="form-group">
          <label>日志级别</label>
          <select name="logLevel">
            <option value="debug">debug</option>
            <option value="info">info</option>
            <option value="warn">warn</option>
            <option value="error">error</option>
          </select>
        </div>
        <div class="form-group">
          <label>WebUI 端口（重启后生效）</label>
          <input name="webuiPort" type="number" min="1" max="65535">
        </div>
        <div style="grid-column: 1 / -1; display: flex; gap: 10px; margin-top: 6px;">
          <button class="btn" type="submit">保存配置</button>
          <button class="btn secondary" type="button" id="btnLogin">重新登录</button>
          <button class="btn secondary" type="button" id="btnRestart">重启 Bot</button>
          <button class="btn danger" type="button" id="btnStop">关闭 Bot</button>
        </div>
      </form>
    </div>
  </div>

  <!-- 联系人管理 -->
  <div class="panel" id="panel-contacts">
    <div class="card">
      <h3>添加好友 / 加入群组</h3>
      <form id="contactAddForm" class="form-grid" style="grid-template-columns: 1fr 1fr auto; align-items: end;">
        <div class="form-field">
          <label for="contactType">类型</label>
          <select id="contactType">
            <option value="friend">添加好友</option>
            <option value="group">加入群组</option>
          </select>
        </div>
        <div class="form-field">
          <label for="contactValue">UID / 群ID</label>
          <input type="text" id="contactValue" placeholder="ncuid / uid / group_id" autocomplete="off">
        </div>
        <button type="submit" class="btn">添加</button>
      </form>
      <div class="config-error" id="contactAddError"></div>
    </div>

    <div class="card">
      <div style="display:flex;justify-content:space-between;align-items:center;">
        <h3>好友列表 <span class="badge" id="friendCount">0</span></h3>
        <button class="btn secondary small" id="btnRefreshContacts">刷新</button>
      </div>
      <div id="friendList"><div class="empty">加载中...</div></div>
    </div>

    <div class="card">
      <h3>群组列表 <span class="badge" id="groupCount">0</span></h3>
      <div id="groupList"><div class="empty">加载中...</div></div>
    </div>
  </div>

  <!-- 日志查看 -->
  <div class="panel" id="panel-logs">
    <div class="log-box" id="logBox"></div>
  </div>
</div>

<div class="toast" id="toast"></div>

<!-- 插件配置编辑模态框 -->
<div class="modal-mask" id="configModal">
  <div class="modal">
    <div class="modal-head">
      <h3 id="configModalTitle">插件配置</h3>
      <button class="modal-close" id="configModalClose">×</button>
    </div>
    <div class="modal-body">
      <textarea class="config-editor" id="configEditor" spellcheck="false"></textarea>
      <div class="config-error" id="configError"></div>
    </div>
    <div class="modal-foot">
      <button class="btn secondary small" id="configModalCancel">取消</button>
      <button class="btn small" id="configModalSave">保存并重载</button>
    </div>
  </div>
</div>

<script>
const $ = (s) => document.querySelector(s);
const $$ = (s) => document.querySelectorAll(s);
let toastTimer = null;

function showToast(msg) {
  const t = $('#toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.classList.remove('show'), 2500);
}

async function api(path, options = {}) {
  const res = await fetch('/api' + path, {
    headers: { 'Content-Type': 'application/json' },
    ...options,
  });
  const data = await res.json().catch(() => ({}));
  if (!res.ok) throw new Error(data.error || '请求失败');
  return data;
}

// ===== 标签页 =====
$$('.tab-btn').forEach((btn) => {
  btn.addEventListener('click', () => {
    $$('.tab-btn').forEach((b) => b.classList.remove('active'));
    btn.classList.add('active');
    $$('.panel').forEach((p) => p.classList.remove('active'));
    $('#panel-' + btn.dataset.tab).classList.add('active');
    if (btn.dataset.tab === 'plugins') loadPlugins();
    if (btn.dataset.tab === 'config') loadConfig();
    if (btn.dataset.tab === 'contacts') loadContacts();
    if (btn.dataset.tab === 'logs') loadLogs();
  });
});

// ===== 联系人管理 =====
async function loadContacts() {
  try {
    const data = await api('/contacts');
    const friends = data.friends || [];
    const groups = data.groups || [];
    $('#friendCount').textContent = friends.length;
    $('#groupCount').textContent = groups.length;

    // 好友列表
    const fl = $('#friendList');
    if (!friends.length) {
      fl.innerHTML = '<div class="empty">暂无好友</div>';
    } else {
      fl.innerHTML = friends.map((f) => `
        <div class="plugin-item">
          <div class="plugin-info">
            <div class="plugin-name">${escapeHtml(f.name || f.uid || '未知')}</div>
            <div class="plugin-meta">${escapeHtml(f.uid || '')}${f.remark_name ? ' · 备注:' + escapeHtml(f.remark_name) : ''}</div>
          </div>
        </div>
      `).join('');
    }

    // 群组列表
    const gl = $('#groupList');
    if (!groups.length) {
      gl.innerHTML = '<div class="empty">暂无群组</div>';
    } else {
      gl.innerHTML = groups.map((g) => `
        <div class="plugin-item">
          <div class="plugin-info">
            <div class="plugin-name">${escapeHtml(g.name || g.id || '未知群组')}</div>
            <div class="plugin-meta">${escapeHtml(g.id || '')}${g.member_count ? ' · ' + g.member_count + ' 人' : ''}</div>
          </div>
        </div>
      `).join('');
    }
  } catch (e) {
    $('#friendList').innerHTML = `<div class="empty">加载失败: ${escapeHtml(e.message)}</div>`;
  }
}

// 刷新联系人
$('#btnRefreshContacts').addEventListener('click', () => {
  $('#btnRefreshContacts').textContent = '刷新中...';
  loadContacts().finally(() => {
    $('#btnRefreshContacts').textContent = '刷新';
  });
});

// 添加好友 / 加入群组
$('#contactAddForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const type = $('#contactType').value;
  const value = $('#contactValue').value.trim();
  const errEl = $('#contactAddError');
  errEl.textContent = '';
  if (!value) {
    errEl.textContent = '请输入 UID 或群 ID';
    return;
  }
  try {
    if (type === 'friend') {
      await api('/contacts/friend', { method: 'POST', body: JSON.stringify({ uid: value }) });
    } else {
      await api('/contacts/group', { method: 'POST', body: JSON.stringify({ group_id: value }) });
    }
    showToast(type === 'friend' ? '好友申请已发送' : '已提交加群申请');
    $('#contactValue').value = '';
    loadContacts();
  } catch (err) {
    errEl.textContent = '操作失败: ' + err.message;
  }
});

// ===== 插件管理 =====
async function loadPlugins() {
  try {
    const data = await api('/plugins');
    const list = $('#pluginList');
    if (!data.plugins || data.plugins.length === 0) {
      list.innerHTML = '<div class="empty">暂无插件</div>';
      return;
    }
    list.innerHTML = data.plugins.map((p) => `
      <div class="plugin-item">
        <div class="plugin-info">
          <div class="plugin-name">${escapeHtml(p.name)} <span class="badge ${p.enabled ? '' : 'off'}">${p.enabled ? '启用' : '停用'}</span></div>
          <div class="plugin-meta">v${escapeHtml(p.version)} · ${escapeHtml(p.author || '未知作者')} · ${escapeHtml(p.main)}</div>
          ${p.description ? `<div class="plugin-desc">${escapeHtml(p.description)}</div>` : ''}
        </div>
        <div class="plugin-actions">
          <button class="btn small secondary" data-reload="${p.name}">重载</button>
          <button class="btn small" data-config="${p.name}">配置</button>
          <label class="switch">
            <input type="checkbox" ${p.enabled ? 'checked' : ''} data-name="${p.name}" data-toggle>
            <span class="slider"></span>
          </label>
        </div>
      </div>
    `).join('');
    $$('[data-toggle]').forEach((el) => {
      el.addEventListener('change', async () => {
        try {
          const r = await api('/plugins/' + el.dataset.name + '/toggle', { method: 'POST' });
          showToast(`${el.dataset.name} ${r.enabled ? '已启用' : '已停用'}`);
        } catch (e) { showToast('操作失败: ' + e.message); loadPlugins(); }
      });
    });
    // 重载插件按钮
    $$('[data-reload]').forEach((el) => {
      el.addEventListener('click', async () => {
        try {
          await api('/plugins/' + el.dataset.reload + '/reload', { method: 'POST' });
          showToast(`${el.dataset.reload} 已重载`);
        } catch (e) { showToast('重载失败: ' + e.message); }
      });
    });
    // 打开配置编辑面板
    $$('[data-config]').forEach((el) => {
      el.addEventListener('click', () => openPluginConfig(el.dataset.config));
    });
  } catch (e) {
    $('#pluginList').innerHTML = `<div class="empty">加载失败: ${escapeHtml(e.message)}</div>`;
  }
}

// ===== 插件配置面板 =====
let configEditingPlugin = null;

function openPluginConfig(name) {
  configEditingPlugin = name;
  $('#configModalTitle').textContent = `插件配置 - ${name}`;
  $('#configError').textContent = '';
  $('#configEditor').value = '加载中...';
  $('#configModal').classList.add('show');
  api('/plugins/' + name + '/config').then((data) => {
    $('#configEditor').value = JSON.stringify(data.config || {}, null, 2);
  }).catch((e) => {
    $('#configError').textContent = '加载配置失败: ' + e.message;
  });
}

function closeConfigModal() {
  $('#configModal').classList.remove('show');
  configEditingPlugin = null;
}

$('#configModalClose').addEventListener('click', closeConfigModal);
$('#configModalCancel').addEventListener('click', closeConfigModal);
$('#configModal').addEventListener('click', (e) => {
  if (e.target === $('#configModal')) closeConfigModal();
});

$('#configModalSave').addEventListener('click', async () => {
  if (!configEditingPlugin) return;
  let parsed;
  try {
    parsed = JSON.parse($('#configEditor').value);
  } catch (e) {
    $('#configError').textContent = 'JSON 格式错误: ' + e.message;
    return;
  }
  try {
    await api('/plugins/' + configEditingPlugin + '/config', {
      method: 'POST',
      body: JSON.stringify({ config: parsed }),
    });
    // 保存后自动重载插件，使新配置生效
    await api('/plugins/' + configEditingPlugin + '/reload', { method: 'POST' });
    showToast(`${configEditingPlugin} 配置已保存并重载`);
    closeConfigModal();
    loadPlugins();
  } catch (e) {
    $('#configError').textContent = '保存失败: ' + e.message;
  }
});

// ===== 配置管理 =====
async function loadConfig() {
  try {
    const data = await api('/config');
    const form = $('#configForm');
    ['backendOrigin', 'mediaOrigin', 'username', 'logLevel', 'webuiPort'].forEach((k) => {
      if (form.elements[k] && data[k] !== undefined) form.elements[k].value = data[k];
    });
    form.elements.password.value = '';
  } catch (e) { showToast('配置加载失败: ' + e.message); }
}

$('#configForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const form = e.target;
  const payload = {};
  ['backendOrigin', 'mediaOrigin', 'username', 'password', 'logLevel', 'webuiPort'].forEach((k) => {
    const v = form.elements[k].value.trim();
    if (v !== '') payload[k] = k === 'webuiPort' ? parseInt(v, 10) : v;
  });
  try {
    await api('/config', { method: 'POST', body: JSON.stringify(payload) });
    showToast('配置已保存');
    loadConfig();
  } catch (err) { showToast('保存失败: ' + err.message); }
});

$('#btnLogin').addEventListener('click', async () => {
  try {
    await api('/bot/login', { method: 'POST' });
    showToast('已触发重新登录');
  } catch (e) { showToast('登录失败: ' + e.message); }
});

$('#btnRestart').addEventListener('click', async () => {
  if (!confirm('确定重启 Bot 核心？（会断开当前连接并重新登录）')) return;
  try {
    await api('/bot/restart', { method: 'POST' });
    showToast('Bot 已重启');
  } catch (e) { showToast('重启失败: ' + e.message); }
});

// 关闭 Bot：双重确认（两次都确认才执行）
$('#btnStop').addEventListener('click', async () => {
  if (!confirm('确定要关闭 Bot 吗？关闭后进程将退出。')) return;
  if (!confirm('再次确认：真的要关闭 Bot 吗？（此操作不可撤销）')) return;
  try {
    await api('/stop', { method: 'POST' });
    showToast('Bot 正在关闭...');
    $('#btnStop').disabled = true;
    $('#btnStop').textContent = '关闭中...';
  } catch (e) { showToast('关闭失败: ' + e.message); }
});

// ===== 状态轮询 =====
async function refreshStatus() {
  try {
    const data = await api('/bot/status');
    const dot = $('#statusDot');
    dot.classList.toggle('online', data.online);
    $('#statusText').textContent = data.online ? '在线' : '离线';
    $('#statusUser').textContent = data.username ? `当前用户: ${data.username} (${data.uid || '-'})` : '未登录';
    $('#statusUptime').textContent = data.uptime > 0 ? `运行 ${formatUptime(data.uptime)}` : '';
  } catch {}
}
function formatUptime(s) {
  const h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60);
  return h > 0 ? `${h}小时${m}分` : `${m}分钟`;
}

// ===== 日志 =====
let logTimer = null;
async function loadLogs() {
  try {
    const data = await api('/logs?limit=300');
    const box = $('#logBox');
    const atBottom = box.scrollHeight - box.scrollTop - box.clientHeight < 60;
    box.innerHTML = (data.logs || []).map((entry) => {
      const ts = entry.timestamp || '';
      const level = (entry.level || 'info').toLowerCase();
      const msg = entry.message || '';
      const timeHtml = ts ? `<span class="log-time">[${escapeHtml(ts)}]</span>` : '';
      return `<div class="log-entry ${level}">${timeHtml}<span class="log-level">${escapeHtml(level)}:</span><span class="log-msg">${escapeHtml(msg)}</span></div>`;
    }).join('');
    if (atBottom) box.scrollTop = box.scrollHeight;
  } catch {}
}
function startLogPolling() {
  if (logTimer) return;
  loadLogs();
  logTimer = setInterval(loadLogs, 3000);
}

function escapeHtml(str) {
  return String(str ?? '').replace(/[&<>"']/g, (c) => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
  }[c]));
}

// ===== 初始化 =====
loadPlugins();
loadConfig();
refreshStatus();
startLogPolling();
setInterval(refreshStatus, 5000);
</script>
</body>
</html>
